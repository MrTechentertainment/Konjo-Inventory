NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only. Never prefix this key with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Generate a long random value for hashing visitor identifiers used by rate limiting.
RATE_LIMIT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
